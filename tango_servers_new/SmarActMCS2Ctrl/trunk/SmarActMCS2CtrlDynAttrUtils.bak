/**
 *	Add a CmdGetDouble dynamic command.
 *
 *  parameter cmdname: command name to be cretated and added.
 *  parameter device:  Set this flag to true if the command must be added for only this device.
 */
//--------------------------------------------------------
void SmarActMCS2Ctrl::add_CmdGetDouble_dynamic_command(string cmdname, bool device)
{
	CmdGetDoubleClass	*pCmdGetDoubleCmd =
		new CmdGetDoubleClass(cmdname.c_str(),
			Tango::DEVVAR_LONGARRAY, Tango::DEV_DOUBLE,
			"0: channel idx\n1: source idx",
			"value",
			Tango::OPERATOR);
	add_command(pCmdGetDoubleCmd, device);
}
