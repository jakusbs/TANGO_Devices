//--------------------------------------------------------
void Smaract::open_smaract()
{
	DEBUG_STREAM << "Smaract::OpenSmaract()  - " << device_name << endl;
	/*----- PROTECTED REGION ID(Smaract::open_smaract) ENABLED START -----*/
	
	//	Add your own code

	// first set State and Status to init
	set_state(Tango::INIT);
	set_status("Opening Smaract Stage");

	// reset channel active flags for 3(!!) channels
	for (SA_INDEX channel=0; channel<3; channel++) channelActive[channel] = false;

	// open device and get Handle
	
	INFO_STREAM << "Smaract::open_smaract()  - ID=" << smaractIdentifier << "Param=" << smaractOpenCommand << endl;
	cout << "Smaract: opening stage " << smaractIdentifier<< " (" << smaractOpenCommand << ")" << endl;

	SmaractResult = SA_OpenSystem(&SmaractHandle, smaractIdentifier.c_str(), smaractOpenCommand.c_str());
	
	
	if (SmaractResult != SA_OK) {
		SA_GetStatusInfo(SmaractResult,&errorText); // errorText points to a descriptive text		

		ERROR_STREAM << "Smaract::init_device()  - error opening " << smaractIdentifier << ": " << errorText<< endl;
		cout << "Smaract: error opening " << smaractIdentifier << ": " << errorText<< endl;
		
		// set State and Status to unknown
		set_state(Tango::UNKNOWN);
		set_status("Failed to open Smaract: " + string(errorText));
	} else
		{
		// set State and Status to on
		set_state(Tango::ON);
		set_status("Stage is ready to move");
	}

	
	/*----- PROTECTED REGION END -----*/	//	Smaract::open_smaract
}
