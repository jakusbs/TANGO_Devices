void Smaract::always_executed_hook()
{
	INFO_STREAM << "Smaract::always_executed_hook()  " << device_name << endl;
	/*----- PROTECTED REGION ID(Smaract::always_executed_hook) ENABLED START -----*/
	
	//	code always executed before all requests
	
	if (get_state() == Tango::MOVING) {
		// check and update stage movement status for all 3 channels
		unsigned int status;

		for (SA_INDEX channel=0; channel<3; channel++) {
			if (channelActive[channel]) {
				// channel is marked active, so get updated status
				SmaractResult = SA_GetStatus_S(SmaractHandle, channel, &status);
			
				// check if error occurred in response
				if (SmaractResult != SA_OK) {
					SA_GetStatusInfo(SmaractResult,&errorText); // errorText points to a descriptive text
					set_state(Tango::UNKNOWN);
					set_status("Communication error@channel " + to_string(channel) + ": " + string(errorText));
				} 
				else {
					if (status == SA_STOPPED_STATUS) {
						channelActive[channel] = false;	// no error and not active
					}
				}
			} // end_if active
		}

		// is there still movement at one or more channels?	
		if (!(channelActive[0] || channelActive[1] || channelActive[2])) {
			// no movement of stage, so indicate "ON"
			set_state(Tango::ON);
			set_status("Stage is ready to move");
		}
	} // end_if MOVING
	
	
	/*----- PROTECTED REGION END -----*/	//	Smaract::always_executed_hook
