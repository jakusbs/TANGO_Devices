      </argout>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
    </commands>
    <commands name="AutoTilt_SetVerticalSlope" description="Initiates slope determination for Autotilt.&#xA;Select after focusing a point which is displaced vertically (pos2 coordinate)" execMethod="auto_tilt__set_vertical_slope" displayLevel="OPERATOR" polledPeriod="0" isDynamic="false">
