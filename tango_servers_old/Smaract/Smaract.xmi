<?xml version="1.0" encoding="ASCII"?>
<pogoDsl:PogoSystem xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:pogoDsl="http://www.esrf.fr/tango/pogo/PogoDsl">
  <classes name="Smaract" pogoRevision="9.4">
    <description description="Driver for a Smaract Piezo using the MCS controller connected via Ethernet" title="Smaract Piezo Motor" sourcePath="/home/intermag/TangoServers/Smaract" language="Cpp" filestogenerate="XMI   file,Code files,Protected Regions" license="GPL" hasMandatoryProperty="false" hasConcreteProperty="true" hasAbstractCommand="false" hasAbstractAttribute="false">
      <inheritances classname="Device_Impl" sourcePath=""/>
      <identification contact="at mat.ethz.ch - christian.stamm" author="christian.stamm" emailDomain="mat.ethz.ch" classFamily="Motion" siteSpecific="" platform="All Platforms" bus="Ethernet" manufacturer="Smaract" reference="MCS"/>
    </description>
    <deviceProperties name="SmaractIdentifier" description="Identifier string for the Smaract controller on the network. The default reflects the factory setting.">
      <type xsi:type="pogoDsl:StringType"/>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
      <DefaultPropValue>network:192.168.1.200:5000</DefaultPropValue>
    </deviceProperties>
    <deviceProperties name="SmaractOpenCommand" description="Command to pass to the Smaract MCS controller during opening">
      <type xsi:type="pogoDsl:StringType"/>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
      <DefaultPropValue>sync,open-timeout 2000</DefaultPropValue>
    </deviceProperties>
    <deviceProperties name="HoldTime" description="Stage hold time in ms, range 0-60000. A 0 deactivates this feature, a value of 60000 is infinite.">
      <type xsi:type="pogoDsl:UIntType"/>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
      <DefaultPropValue>0</DefaultPropValue>
    </deviceProperties>
    <deviceProperties name="AutotiltMaxCorrection" description="Maximum correction in microns of focus position for Autotilt">
      <type xsi:type="pogoDsl:DoubleType"/>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
      <DefaultPropValue>100</DefaultPropValue>
    </deviceProperties>
    <commands name="State" description="This command gets the device state (stored in its device_state data member) and returns it to the caller." execMethod="dev_state" displayLevel="OPERATOR" polledPeriod="0">
      <argin description="none">
        <type xsi:type="pogoDsl:VoidType"/>
      </argin>
      <argout description="Device state">
        <type xsi:type="pogoDsl:StateType"/>
      </argout>
      <status abstract="true" inherited="true" concrete="true" concreteHere="false"/>
    </commands>
    <commands name="Status" description="This command gets the device status (stored in its device_status data member) and returns it to the caller." execMethod="dev_status" displayLevel="OPERATOR" polledPeriod="0">
      <argin description="none">
        <type xsi:type="pogoDsl:VoidType"/>
      </argin>
      <argout description="Device status">
        <type xsi:type="pogoDsl:ConstStringType"/>
      </argout>
      <status abstract="true" inherited="true" concrete="true" concreteHere="false"/>
    </commands>
    <commands name="OpenSmaract" description="Opens the Smaract MCS controller" execMethod="open_smaract" displayLevel="OPERATOR" polledPeriod="0">
      <argin description="">
        <type xsi:type="pogoDsl:VoidType"/>
      </argin>
      <argout description="">
        <type xsi:type="pogoDsl:VoidType"/>
      </argout>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
      <excludedStates>ON</excludedStates>
      <excludedStates>INIT</excludedStates>
      <excludedStates>MOVING</excludedStates>
    </commands>
    <commands name="CloseSmaract" description="Close connection to Smaract controller" execMethod="close_smaract" displayLevel="OPERATOR" polledPeriod="0">
      <argin description="">
        <type xsi:type="pogoDsl:VoidType"/>
      </argin>
      <argout description="">
        <type xsi:type="pogoDsl:VoidType"/>
      </argout>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
    </commands>
    <commands name="FindReferenceMark" description="Find reference mark and zero the position there" execMethod="find_reference_mark" displayLevel="OPERATOR" polledPeriod="0">
      <argin description="">
        <type xsi:type="pogoDsl:VoidType"/>
      </argin>
      <argout description="">
        <type xsi:type="pogoDsl:VoidType"/>
      </argout>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
      <excludedStates>INIT</excludedStates>
      <excludedStates>MOVING</excludedStates>
      <excludedStates>FAULT</excludedStates>
      <excludedStates>UNKNOWN</excludedStates>
    </commands>
    <commands name="Abort" description="Abort current movement (used in scanserver plugin)" execMethod="abort" displayLevel="OPERATOR" polledPeriod="0">
