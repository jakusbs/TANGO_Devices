    <commands name="AutoTilt_SetOrigin" description="Initiates slope determination for Autotilt.&#xA;Select after focusing roughly within the area of interest" execMethod="auto_tilt__set_origin" displayLevel="OPERATOR" polledPeriod="0" isDynamic="false">
