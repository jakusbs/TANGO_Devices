      </argout>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
    </commands>
    <commands name="AutoTilt_SetHorizontalSlope" description="Initiates slope determination for Autotilt.&#xA;Select after focusing a point which is displaced horizontally (pos1 coordinate)" execMethod="auto_tilt__set_horizontal_slope" displayLevel="OPERATOR" polledPeriod="0" isDynamic="false">
      <argin description="">
        <type xsi:type="pogoDsl:VoidType"/>
      </argin>
