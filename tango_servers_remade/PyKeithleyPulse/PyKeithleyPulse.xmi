  <classes name="PyKeithleyPulse" pogoRevision="9.1">
    <description description="Controls a Keithley 6221 current source in square-wave (pulse) mode via a Socket TANGO device." title="PyKeithleyPulse - Keithley 6221 square-wave generator" sourcePath="/home/intermag/TangoServers/PyKeithleyPulse" language="PythonHL" filestogenerate="XMI   file,Code files,Protected Regions" license="GPL" copyright="" hasMandatoryProperty="false" hasConcreteProperty="true" hasAbstractCommand="false" hasAbstractAttribute="false">
