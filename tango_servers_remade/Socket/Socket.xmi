<?xml version="1.0" encoding="ASCII"?>
<pogoDsl:PogoSystem xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:pogoDsl="http://tango-controls.org/pogo/PogoDsl">
  <classes name="Socket" pogoRevision="9.1">
    <description description="TCP socket gateway device. Wraps a raw TCP connection and exposes read/write commands for use by other TANGO devices." title="Socket" sourcePath="/home/intermag/TangoServers/Socket" language="PythonHL" filestogenerate="XMI   file,Code files,Protected Regions" license="GPL" copyright="" hasMandatoryProperty="true" hasConcreteProperty="true" hasAbstractCommand="false" hasAbstractAttribute="false">
      <inheritances classname="Device_Impl" sourcePath=""/>
      <identification contact="at mat.ethz.ch - acremann" author="acremann" emailDomain="mat.ethz.ch" classFamily="Communication" siteSpecific="" platform="All Platforms" bus="Ethernet" manufacturer="none" reference=""/>
    </description>
    <deviceProperties name="Hostname" mandatory="true" description="Remote hostname or IP address to connect to">
      <type xsi:type="pogoDsl:StringType"/>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
    </deviceProperties>
    <deviceProperties name="Port" mandatory="true" description="TCP port number">
      <type xsi:type="pogoDsl:IntType"/>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
    </deviceProperties>
    <deviceProperties name="Readtimeout" description="Socket read timeout in milliseconds">
      <type xsi:type="pogoDsl:IntType"/>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
      <DefaultPropValue>1000</DefaultPropValue>
    </deviceProperties>
    <commands name="State" description="This command gets the device state (stored in its device_state data member) and returns it to the caller." execMethod="dev_state" displayLevel="OPERATOR" polledPeriod="0">
      <argin description="none">
        <type xsi:type="pogoDsl:VoidType"/>
      </argin>
      <argout description="Device state">
        <type xsi:type="pogoDsl:StateType"/>
      </argout>
      <status abstract="true" inherited="true" concrete="true"/>
    </commands>
    <commands name="Status" description="This command gets the device status (stored in its device_status data member) and returns it to the caller." execMethod="dev_status" displayLevel="OPERATOR" polledPeriod="0">
      <argin description="none">
        <type xsi:type="pogoDsl:VoidType"/>
      </argin>
      <argout description="Device status">
        <type xsi:type="pogoDsl:ConstStringType"/>
      </argout>
      <status abstract="true" inherited="true" concrete="true"/>
    </commands>
    <commands name="Write" description="Send a string to the socket (no newline appended)" execMethod="write" displayLevel="OPERATOR" polledPeriod="0" isDynamic="false">
      <argin description="String to send">
        <type xsi:type="pogoDsl:StringType"/>
      </argin>
      <argout description="">
        <type xsi:type="pogoDsl:VoidType"/>
      </argout>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
    </commands>
    <commands name="Read" description="Read available data from the socket" execMethod="read" displayLevel="OPERATOR" polledPeriod="0" isDynamic="false">
      <argin description="">
        <type xsi:type="pogoDsl:VoidType"/>
      </argin>
      <argout description="Received string">
        <type xsi:type="pogoDsl:StringType"/>
      </argout>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
    </commands>
    <commands name="Reconnect" description="Close and reopen the TCP connection" execMethod="reconnect" displayLevel="OPERATOR" polledPeriod="0" isDynamic="false">
      <argin description="">
        <type xsi:type="pogoDsl:VoidType"/>
      </argin>
      <argout description="">
        <type xsi:type="pogoDsl:VoidType"/>
      </argout>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
    </commands>
    <commands name="WriteAndRead" description="Write a string then immediately read the response" execMethod="write_and_read" displayLevel="OPERATOR" polledPeriod="0" isDynamic="false">
      <argin description="String to send">
        <type xsi:type="pogoDsl:StringType"/>
      </argin>
      <argout description="Received string">
        <type xsi:type="pogoDsl:StringType"/>
      </argout>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
    </commands>
    <commands name="Readln" description="Read characters until a newline character is received" execMethod="readln" displayLevel="OPERATOR" polledPeriod="0" isDynamic="false">
      <argin description="">
        <type xsi:type="pogoDsl:VoidType"/>
      </argin>
      <argout description="Line read from socket (strips trailing newline)">
        <type xsi:type="pogoDsl:StringType"/>
      </argout>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
    </commands>
    <commands name="ReadUntil" description="Read characters until the given terminator string is received" execMethod="read_until" displayLevel="OPERATOR" polledPeriod="0" isDynamic="false">
      <argin description="Terminator string">
        <type xsi:type="pogoDsl:StringType"/>
      </argin>
      <argout description="Data read up to and including the terminator">
        <type xsi:type="pogoDsl:StringType"/>
      </argout>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
    </commands>
    <commands name="WriteReadUntil" description="Write argin[0], then read until argin[1] is received" execMethod="write_read_until" displayLevel="OPERATOR" polledPeriod="0" isDynamic="false">
      <argin description="[write_string, terminator]">
        <type xsi:type="pogoDsl:StringArrayType"/>
      </argin>
      <argout description="Response up to and including the terminator">
        <type xsi:type="pogoDsl:StringType"/>
      </argout>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
    </commands>
    <commands name="WriteLine" description="Send a string followed by a newline character" execMethod="write_line" displayLevel="OPERATOR" polledPeriod="0" isDynamic="false">
      <argin description="String to send (newline appended)">
        <type xsi:type="pogoDsl:StringType"/>
      </argin>
      <argout description="">
        <type xsi:type="pogoDsl:VoidType"/>
      </argout>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
    </commands>
    <commands name="WriteRead" description="Write a string then read the response" execMethod="write_read" displayLevel="OPERATOR" polledPeriod="0" isDynamic="false">
      <argin description="String to send">
        <type xsi:type="pogoDsl:StringType"/>
      </argin>
      <argout description="Received string">
        <type xsi:type="pogoDsl:StringType"/>
      </argout>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
    </commands>
    <commands name="WriteReadZero" description="Write a string then read characters until a null byte is received" execMethod="write_read_zero" displayLevel="OPERATOR" polledPeriod="0" isDynamic="false">
      <argin description="String to send">
        <type xsi:type="pogoDsl:StringType"/>
      </argin>
      <argout description="Response up to the null character">
        <type xsi:type="pogoDsl:StringType"/>
      </argout>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
    </commands>
    <commands name="ReadChar" description="Read a single character from the socket" execMethod="read_char" displayLevel="OPERATOR" polledPeriod="0" isDynamic="false">
      <argin description="">
        <type xsi:type="pogoDsl:VoidType"/>
      </argin>
      <argout description="Single character read from socket">
        <type xsi:type="pogoDsl:StringType"/>
      </argout>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
    </commands>
    <states name="ON" description="Connected and ready.">
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
    </states>
    <states name="FAULT" description="Connection failed — call Reconnect to recover.">
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
    </states>
    <preferences docHome="./doc_html" makefileHome="/usr/share/pogo/preferences"/>
  </classes>
</pogoDsl:PogoSystem>
